<!DOCTYPE html>
<html lang="es" >
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
    
    @* LOGO *@
    <link rel="icon" href="~/logo.png" />
</head>
<body class="">
    @* CABECERA *@
    <header>
        @* Controlador y View Actual *@
        @{
            string controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
            string accionActual = ViewContext.RouteData.Values["action"]?.ToString();
        }

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid position-relative">
                @* TÍTULO PRINCIPAL *@
                <a class="navbar-brand fw-bold ms-4 hover-lift" asp-area="" asp-controller="Home" asp-action="Index">SysFiscalía</a>
                @* BUTTON RESPONSIVO *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            
                @* CONTENEDOR DE OPCIONES DISTRIBUIDO *@
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">

                    @* CONTENEDOR DERECHO *@
                    @* Se muestra dependiendo de si hay un usuario logueado *@
                    @if(Context.Session.GetInt32("IdLogueado") != null)
                    {
                        <ul class="navbar-nav">
                            @if (controladorActual == "Investigador" && accionActual != "Index")
                                {
                                    <li class="nav-item">
                                        <a class="btn btn-outline-secondary btn-sm px-3 mx-3" "
                                        asp-area="" asp-controller="Investigador"
                                        asp-action="Index">Volver al Inicio</a>
                                    </li>
                                }
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm px-3 mx-3" asp-area="" asp-controller="Acceso" asp-action="Logout">Logout</a>
                            </li>
                        </ul>
                    } else
                    {
                        <ul class="navbar-nav">
                            @* ÍTEM *@
                            <li class="nav-item hover-lift">
                                <a class="btn btn-primary btn-sm px-3 mx-3" asp-area="" asp-controller="Acceso" asp-action="Login">Log In</a>
                            </li>
                        </ul>
                    }
                    
                </div>
            </div>
        </nav>
    </header>

    @* VISTAS SEGÚN CONTROLLER *@
    <div class="container d-flex flex-column justify-content-center">
        <div class="container-fluid">
            <main role="main" class="pb-4 p-0">
                @RenderBody()
            </main>
        </div>
    </div>

    @* PIE *@
    <footer class="border-top footer bg-dark text-light">
        <div class="container">
            &copy; 2026 - SysFiscalía | Diego Weble - 363671 | ORT | N2A | Parte 2 Obligatorio
        </div>
    </footer>
    
    @* SCRIPTS *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>