@using Dominio

@{
    ViewData["Title"] = "Investigador - SysFiscalía";
}

@* MODELO con el Investigador Logueado *@
@model Investigador

<div class="container-fluid">
    @* BIENVENIDA tras Login *@
    <div class="container p-0">
        <div class="text-center my-4">
            <h1 class="display-4">Sistema de Fiscalía</h1>
        </div>
        <div class="card my-4">
            <div class="card-body text-center">
                Revolucionando nuestros procesos Judiciales
            </div>
        </div>

        <div class="card my-4">
            <div class="card-header">
                SysFiscalía
            </div>
            <div class="card-body">
                <h4 class="card-title">¡Bienvenido @Model.Rol, @Model.Nombre !</h4>
                <p class="card-text">
                    La nueva aplicación que permite
                    delegar las imputaciones y facilitar la resolución de los casos
                </p>
            </div>
        </div>

        @* Opciones acorde al ROL del Logueado *@
        @if (@Model.Rol.ToString() == "Detective")
        {
            @* OPCIONES de DETECTIVES *@
            <div class="row">
                <div class="col-sm-6 mb-3 mb-sm-0">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Mis Casos Asignados</h5>
                            <p class="card-text">Seleccionar esta opcion para ver Mis Casos como Detective.</p>
                            @* Boton que redirige a Casos Asignados a Detective *@
                            <button type="button" class="btn btn-success">
                                <a class="text-white text-decoration-none"
                                   asp-area="" asp-controller="Investigador"
                                   asp-action="Casos">Ir a Mis Casos</a>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 mb-3 mb-sm-0">
                    <div class="card text-end">
                        <div class="card-body">
                            <h5 class="card-title">Sospechosos</h5>
                            <p class="card-text">Seleccionar esta opcion para ver el listado completo de Sospechosos.</p>
                            @* Boton que redirige al Listado de Sospechosos del Sistema *@
                            <button type="button" class="btn btn-warning">
                                <a class="text-dark text-decoration-none"
                                   asp-area="" asp-controller="Investigador"
                                   asp-action="ListadoSospechosos">Ver listado</a>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        } else {
            @* Opciones de de FISCALES *@
            <div class="row">
                <div class="col-sm-6 mb-3 mb-sm-0">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Casos</h5>
                            <p class="card-text">Seleccionar esta opcion para ver Todos los Casos del Sistema.</p>
                            <button type="button" class="btn btn-success">
                                <a class="text-white text-decoration-none"
                                asp-area="" asp-controller="Investigador"
                                asp-action="Casos">Ir a Casos</a>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 mb-3 mb-sm-0">
                    <div class="card text-end">
                        <div class="card-body">
                            <h5 class="card-title">Alta de Caso</h5>
                            <p class="card-text">Seleccionar esta opcion para Ingresar un Caso Nuevo.</p>
                            <button type="button" class="btn btn-warning">
                                <a class="text-dark text-decoration-none"
                                   asp-area="" asp-controller="Investigador"
                                   asp-action="CasoAlta">Crear Caso</a>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        @* PERFIL del Investigador*@
        <div class="card my-4">
            <div class="card-header">
                Perfil
            </div>
            <div class="card-body text-center">
                <h4 class="card-title">Mi Perfil</h4>
                <p class="card-text">Seleccionar esta opcion para ver Mis Datos personales como @Model.Rol.</p>
                @* BOTON PARA REDIRIGIR AL PERFIL DEL Invest*@
                <button type="button" class="btn btn-primary">
                    <a class="text-white text-decoration-none" asp-area="" asp-controller="Investigador" asp-action="Perfil">Ver mi perfil</a>
                </button>
            </div>
        </div>

    </div>
</div>
