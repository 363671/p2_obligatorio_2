@using Dominio
@model Caso

<div class="col-12 col-lg-5">
    <div class="d-flex flex-column gap-3">

        @if (Model.GetEvidenciasDelCaso().Count() == 0)
        {
            <div class="alert alert-warning text-center shadow-sm border-0 rounded-3 py-3 mb-0" role="alert">
                <i class="bi bi-folder-x me-1">
                    No existen Evidencias asociadas
                </i>
            </div>
        }

        @foreach (Evidencia e in Model.GetEvidenciasDelCaso())
        {
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center px-3 py-2">
                    <span class="fw-semibold small">Evidencia #@e.Id</span>

                    @if (e is Fisica)
                    {
                        <span class="badge bg-primary">Física</span>
                    }
                    else if (e is Grabacion)
                    {
                        <span class="badge bg-warning text-dark">Grabación</span>
                    }
                    else if (e is Testimonio)
                    {
                        <span class="badge bg-info text-dark">Testimonio</span>
                    }
                </div>

                <div class="card-body p-3">
                    @* Datos generales de la evidencia *@
                    <div class="row g-2 mb-2">
                        <div class="col-sm-4">
                            <span class="text-muted small d-block">Fecha de recolección</span>
                            <p class="fw-semibold small mb-0">
                                @e.FechaRecoleccion.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                        <div class="col-sm-8">
                            <span class="text-muted small d-block">Descripción</span>
                            <p class="small text-secondary mb-0">@e.Descripcion</p>
                        </div>
                    </div>

                    <hr class="my-2 opacity-25" />

                    @* Detalles específicos *@
                    <div class="d-flex align-items-center flex-wrap gap-3 small pt-1">
                        <span class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">
                            Detalles específicos:
                        </span>

                        @* Evidencia Física *@
                        @if (e is Fisica f)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-secondary">Huellas digitales:</span>
                                @if (f.TieneHuellasDigitales)
                                {
                                    <span class="badge bg-success">Sí tiene</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No tiene</span>
                                }
                            </div>
                        }

                        @* Evidencia Grabación *@
                        @if (e is Grabacion g)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-secondary">Calidad:</span>
                                <strong>@g.Calidad</strong>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-secondary text-nowrap">¿In fraganti?</span>
                                @if (g.InFraganti)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </div>
                        }

                        @* Evidencia Testimonio *@
                        @if (e is Testimonio t)
                        {
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-secondary">Testigo:</span>
                                <strong>@t.NombreTestigo</strong>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-secondary">Credibilidad:</span>
                                <strong>@t.IndiceCredibilidad</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
