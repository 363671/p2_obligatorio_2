@*
    La diferencia entre AgregarEvidenciaParaSubFormulario.cshtml y AgregarEvidencia.cshtml
    es que este Archivo es para el Formulario Alta de Caso el cual ya tiene un FORM, y HTML
    no permite anidar FORMS
*@

<div class="d-flex justify-content-center m-3 mb-0 p-2 pt-0">
    <button type="button" id="btnAgregarEvidencia" class="btn btn-primary btn-sm px-3">Agregar evidencia</button>
</div>

<div class="card my-2  mt-0" id="formularioEvidenciaNueva">
    <div class="card-header bg-dark text-white">
        <i><b>Agregar Evidencia</b></i>
    </div>

    @* <p class="card-body"> *@
    @* el metódo será POST - porque se pedirán datos para la Evidencia Nueva *@

    @* <form method="post" id="formEvidenciaNueva" class="form-check form d-flex flex-column"> *@
        <div class="px-4">
            <div id="pAvisoEvidenciaInvalida" class="alert alert-warning m-auto my-3 p-2" role="alert"></div>

            <div class="input-group my-2">
                <span class="input-group-text">Tipo de Evidencia</span>
                <select class="form-control form-select" id="slcTipoEvidencia" name="slcTipoEvidencia">
                    <option value="x" selected>Seleccione una opcion...</option>

                    @foreach (string tE in ViewBag.TiposEvidencias)
                    {
                            <option value="@tE">@tE</option>
                    }
                </select>
            </div>

            <!-- Datos que se piden por cualquier Evidencia  -->
            <div id="divDatosBasicosEvidencias" class="row">
                <div class="input-group my-2">
                    <span class="input-group-text">Fecha recolección</span>
                    <input type="date" name="FechaRecoleccion" class="form-control" min="01/01/1800" max="@TempData["FechaActual"]" />
                </div>
                <div class="input-group my-2">
                    <span class="input-group-text">Descripcion</span>
                    <textarea class="form-control" name="Descripcion" aria-label="With textarea"></textarea>
                </div>
            </div>
            <!-- -->

            <!-- Datos especificos -->
            @* TieneHuellasDigitales *@
            <div id="divTipoEvidenciaFisica" class="form-check form-switch">
                <label class="form-check-label">
                    Incluye huellas digitales
                </label>
                <input class="form-check-input" type="checkbox" name="TieneHuellasDigitales" value="siTiene">
            </div>
                
            @* Calidad *@
            @* InFraganti *@
            <div id="divTipoEvidenciaGrabacion" class="col">
                <div class="input-group my-2">
                    <span class="input-group-text">Calidad</span>
                    <input class="form-control" type="number" min="1" max="5" name="Calidad" />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="InFraganti" switch>
                    <label class="form-check-label">
                        In Fraganti
                    </label>
                </div>
            </div>

            @* Nombre de Testigo *@
            @* IndiceCredibilidad *@
            <div id="divTipoEvidenciaTestimonio" class="col">
                <div class="input-group my-2">
                    <span class="input-group-text">Nombre del Testigo</span>
                    <input class="form-control" type="text" name="NombreTestigo" />
                </div>
                <div class="input-group my-2" role="group" aria-label="Índice de credibilidad">
                    <span class="input-group-text">Credibilidad</span>
  
                    <input type="radio" class="btn-check" name="IndiceCredibilidad" id="credibilidadBaja" value="0" autocomplete="off">
                    <label class="btn btn-outline-primary" for="credibilidadBaja">Baja</label>

                    <input type="radio" class="btn-check" name="IndiceCredibilidad" id="credibilidadMedia" value="1" autocomplete="off">
                    <label class="btn btn-outline-primary" for="credibilidadMedia">Media</label>

                    <input type="radio" class="btn-check" name="IndiceCredibilidad" id="credibilidadAlta" value="2" autocomplete="off">
                    <label class="btn btn-outline-primary" for="credibilidadAlta">Alta</label>
                </div>
            </div>
            <div class="m-auto my-3">
                <button
                    type="button" id="btnCancelarAgregarEvidencia" class="btn btn-outline-danger btn-sm px-3">
                    Cancelar
                </button>
            </div>
        </div>
    @* </form> *@
    
</div>

<div id="divEvidenciaIngresada">

</div>