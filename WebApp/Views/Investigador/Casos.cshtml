@using Dominio
@model Investigador

@if (Model.Rol.ToString() == "Detective")
{
    @if (ViewBag.CasosDetective.Count == 0)
    {
        <p>El Investigador no tiene Casos Asignados</p>
    }
    else
    {
        <h2>Estos son tus Casos:</h2>

        <table class="table table-striped" data-bs-theme="dark">
            <tr class="text-center">
                <th>Id</th>
                <th>Nombre</th>
                <th>Sospechoso</th>
                <th>Detective</th>
                <th>Evidencias @* cantidad *@</th>
                <th>Estado</th>
                <th>Detalles</th>
            </tr>

            @foreach (Caso c in ViewBag.CasosDetective)
            {
                <tr class="text-center">
                    <td>@c.Id</td>
                    <td>@c.Nombre</td>
                    <td>@c.SospechosoPrincipal.Nombre</td>
                    <td>@c.InvestigadorD.Nombre</td>
                    <td>@c._evidenciasDelCaso.Count</td>
                    @if (@c.Activo)
                    {
                        <td>Activo</td>
                    } else
                    {
                        <td>Cerrado</td>
                    }
                    <th>
                        @Html.ActionLink("Ver", "CasoDetalle", new { id = c.Id }, new { style = "text-decoration: none;" })
                        <svg x="0px" y="0px" width="20" height="20" viewBox="0 0 30 30">
                            <path fill="white" d="M 25.980469 2.9902344 A 1.0001 1.0001 0 0 0 25.869141 3 L 20 3 A 1.0001 1.0001 0 1 0 20 5 L 23.585938 5 L 13.292969 15.292969 A 1.0001 1.0001 0 1 0 14.707031 16.707031 L 25 6.4140625 L 25 10 A 1.0001 1.0001 0 1 0 27 10 L 27 4.1269531 A 1.0001 1.0001 0 0 0 25.980469 2.9902344 z M 6 7 C 4.9069372 7 4 7.9069372 4 9 L 4 24 C 4 25.093063 4.9069372 26 6 26 L 21 26 C 22.093063 26 23 25.093063 23 24 L 23 14 L 23 11.421875 L 21 13.421875 L 21 16 L 21 24 L 6 24 L 6 9 L 14 9 L 16 9 L 16.578125 9 L 18.578125 7 L 16 7 L 14 7 L 6 7 z"></path>
                        </svg>
                    </th>

                </tr>
            }
        </table>
    }
}
else
{
    <h2>Estos son los Casos del Sistema</h2>

    <table class="table table-striped table-hover" data-bs-theme="dark">
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Sospechoso</th>
            <th>Detective</th>
            <th>Evidencias @* cantidad *@</th>
            <th>Estado</th>
            <th>Detalles</th>
        </tr>

        @foreach (Caso c in ViewBag.CasosSistema)
        {
            <tr class="text-center">
                <td>@c.Id</td>
                <td>@c.Nombre</td>
                <td>@c.SospechosoPrincipal.Nombre</td>
                <td>@c.InvestigadorD.Nombre</td>
                <td>@c._evidenciasDelCaso.Count</td>
                @if (@c.Activo)
                {
                    <td>Activo</td>
                }
                else
                {
                    <td>Cerrado</td>
                }
                <th>@Html.ActionLink("Ver", "CasoDetalle", new { id = c.Id }, new { style = "text-decoration: none;" })</th>
            </tr>
        }
    </table>
}

<button type="button" class="btn btn-primary mx-auto d-block">
    <a class="text-white text-decoration-none"
       asp-area="" asp-controller="Investigador"
       asp-action="Index">Volver al Inicio</a>
</button>
