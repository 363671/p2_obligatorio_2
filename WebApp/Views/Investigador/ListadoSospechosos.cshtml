
@using Dominio

@model IEnumerable<Sospechoso>

<h3>Listado de todos los Sospechosos</h3>
<br />
<div class="mb-3 alert alert-info" role="alert">Se puede filtrar SOLO de a 1 opcion:</div>

<form method="get">
    <input type="text" name="nombreABuscar" placeholder="Introduce un nombre..." />
    <input type="number" name="edadASuperar" placeholder="Introduce una Edad..." />
    <input type="submit" value="🔎" />
</form>

<br />
<table class="table table-striped table-hover" data-bs-theme="dark">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Cédula</th>
            <th>Fecha de nacimiento</th>
            <th>Edad</th>
            <th>Antecedentes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Sospechoso s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Nombre</td>
                <td>@s.Cedula</td>
                <td>@s.FechaNacimiento.ToShortDateString()</td>
                <td>@s.CalcularEdad()</td>
                <td>@s.AntecedentesAString(s.TieneAntecedentes)</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count() == 0)
{
    <div class="mb-3 alert alert-warning" role="alert">No hay resultados</div>
}