@using Dominio

@{
    ViewData["Title"] = "Sospechosos";
}

@model IEnumerable<Sospechoso>

<div class="container my-4" style="max-width: 720px;">
    <h3 class="mb-3 text-center">Listado de todos los Sospechosos</h3>

    <div class="alert alert-info py-2 mb-3" role="alert">
        <small>Se puede filtrar <strong>SOLO</strong> de a 1 opción:</small>
    </div>

    <form method="get">
        <div class="input-group">
            <!-- Selector de criterio -->
            <span class="input-group-text">Filtrar por</span>
            <select class="form-select" id="slcCriterioFiltrado" name="slcCriterioFiltrado" style="max-width: 190px;">
                <option value="x" selected>Opción...</option>
                <option value="Nombre">Nombre</option>
                <option value="Edad">Edad</option>
                <option value="Antecedentes">Antecedentes</option>
            </select>

            <!-- Input Nombre -->
            <input type="text"
                   class="form-control"
                   id="txtNombre"
                   name="nombreABuscar"
                   placeholder="..."
                   aria-label="Introduce un nombre" />

            <!-- Input Edad -->
            <input type="number"
                   class="form-control"
                   id="edadASuperar"
                   name="edadASuperar"
                   placeholder="...mayor de..."
                   min="0"
                   max="120"
                   style="max-width: 110px;"
                   aria-label="Introduce una edad" />

            <!-- Input Antec -->
            <div class="form-control" role="group" aria-label="antecedentes" id="antecedentes">
  
                <input type="radio" class="btn-check" name="antecedentes" id="no" value="0" autocomplete="off">
                <label class="btn btn-outline-primary" for="no">Sin</label>

                <input type="radio" class="btn-check" name="antecedentes" id="si" value="1" autocomplete="off">
                <label class="btn btn-outline-primary" for="si">Con</label>
            </div>

            <!-- Botón Buscar -->
            <button type="submit" class="btn btn-primary" title="Buscar">🔎</button>
        </div>
    </form>
</div>


<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover align-middle" data-bs-theme="dark">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Cédula</th>
                            <th>Fecha de nacimiento</th>
                            <th>Edad</th>
                            <th>Antecedentes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Sospechoso s in Model)
                        {
                            <tr>
                                <td>@s.Id</td>
                                <td>@s.Nombre</td>
                                <td>@s.Cedula</td>
                                <td>@s.FechaNacimiento.ToShortDateString()</td>
                                <td>@s.CalcularEdad()</td>
                                <td>@s.AntecedentesAString(s.TieneAntecedentes)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.Count() == 0)
                {
                    <div class="mb-3 alert alert-warning" role="alert">No hay resultados</div>
                }
            </div>
            @* Alta de Sospechoso *@
            <button type="button" class="btn btn-primary">
                <a class="text-white text-decoration-none" asp-area="" asp-controller="Investigador" asp-action="SospechosoAlta">Agregar Sospechoso</a>
            </button>
        </div>
    </div>
</div>

<br />

